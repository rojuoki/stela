{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/io-worker.Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "npm run io:pg:migrate && npm run io:pg:verify",
    "startCommand": "node --import tsx scripts/io-pg-worker.ts",
    "numReplicas": 1,
    "sleepApplication": true,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 0,
    "drainingSeconds": 45
  }
}
