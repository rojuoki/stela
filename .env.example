# STELA IO local development
TWITTERAPI_IO_API_KEY=replace_me
# SQLite is retained only for local fixtures and import tests.
STELA_IO_DATABASE_PATH=./data/stela-io.sqlite
# `npm run dev:web` and `npm run dev` manage this loopback PostgreSQL instance.
# Never point local development at the legacy STELA DATABASE_URL.
STELA_IO_DATABASE_URL=postgresql://postgres@127.0.0.1:55440/postgres
STELA_IO_USE_POSTGRES=1
STELA_IO_AUTH_SECRET=local-development-secret-change-before-deploying
# Public legal/support contact shown on Privacy and Terms pages.
# NEXT_PUBLIC_STELA_SUPPORT_EMAIL=support@example.com
STELA_IO_RATE_LIMIT_SALT=local-development-rate-limit-salt-change-before-deploying
STELA_IO_LOGIN_RATE_LIMIT=10
STELA_IO_LOGIN_RATE_WINDOW_SECONDS=900
STELA_IO_SIGNUP_RATE_LIMIT=5
STELA_IO_SIGNUP_RATE_WINDOW_SECONDS=3600
STELA_IO_PREVIEW_RATE_LIMIT=10
STELA_IO_PREVIEW_RATE_WINDOW_SECONDS=3600
STELA_IO_PREVIEW_GLOBAL_LIMIT=100
STELA_IO_PREVIEW_GLOBAL_WINDOW_SECONDS=86400
# With a loopback URL, both dev commands start PostgreSQL and Web. `dev:web`
# deliberately omits the acquisition worker; `dev` starts it. PostgreSQL data
# persists under .local/io-postgres and managed processes stop on Ctrl+C.
# Set this to 0 when managing a local PostgreSQL separately.
# STELA_IO_MANAGE_LOCAL_POSTGRES=0
# STELA_IO_DEV_PG_ROOT=.local/io-postgres
STELA_IO_REQUEST_INTERVAL=0.7
# Shared across all eight local runners (6 request starts per second total).
STELA_IO_PROVIDER_REQUESTS_PER_SECOND=6
# Maximum number of acquisition runs handled concurrently by the IO worker.
STELA_IO_CONCURRENCY=8
# Keeps cache-only grants on the same acquisition screen without an API call.
STELA_IO_CACHE_GRANT_DELAY_MS=750
# Optional explicit operator guardrails. Leave unset for normal long-running work.
# STELA_IO_MAX_REQUESTS=500
# STELA_IO_MAX_ESTIMATED_COST_USD=2.00
STELA_IO_PYTHON=python3
# Optional worker-only direct Neon URL (no -pooler hostname).
# Web may use a pooled URL, but the worker's session lock requires direct Postgres.
# STELA_IO_WORKER_DATABASE_URL=postgresql://user:password@direct-host/database?sslmode=require
# STELA_IO_WORKER_WAKE_URL=http://io-worker.railway.internal:8080/wake
# STELA_IO_WORKER_WAKE_SECRET=generate-a-long-random-secret
# TLS certificates are verified by default. Use 0 only for a trusted local test server.
# STELA_IO_SSL_REJECT_UNAUTHORIZED=0
# Optional disposable working directory. Checkpoints are restored from Postgres.
# STELA_IO_WORK_DIRECTORY=/tmp/stela-io-worker

# Local twscrape provider (manual selection in the prototype UI)
# Use the Python interpreter where twscrape 0.20.x is installed.
STELA_TWSCRAPE_PYTHON=python3
STELA_TWSCRAPE_DB=~/accounts.db
STELA_TWSCRAPE_MAX_REQUESTS=2000
