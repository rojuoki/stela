# Independent TwitterAPI.io prototype
TWITTERAPI_IO_API_KEY=replace_me
STELA_IO_DATABASE_PATH=./data/stela-io.sqlite
# Dedicated Neon/Postgres database for the future IO product path.
# Do not point this at the existing STELA DATABASE_URL.
STELA_IO_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
STELA_IO_USE_POSTGRES=0
STELA_IO_AUTH_SECRET=replace_with_a_long_unique_random_secret
STELA_IO_REQUEST_INTERVAL=0.7
# Shared across all eight local runners (6 request starts per second total).
STELA_IO_PROVIDER_REQUESTS_PER_SECOND=6
# Maximum number of acquisition runs handled concurrently by the IO worker.
STELA_IO_CONCURRENCY=8
# Keeps cache-only grants on the same acquisition screen without an API call.
STELA_IO_CACHE_GRANT_DELAY_MS=750
# Optional explicit operator guardrails. Leave unset for normal long-running work.
# STELA_IO_MAX_REQUESTS=500
# STELA_IO_MAX_ESTIMATED_COST_USD=2.00
STELA_IO_PYTHON=python3
# Optional worker-only direct Neon URL (no -pooler hostname).
# Web may use a pooled URL, but the worker's session lock requires direct Postgres.
# STELA_IO_WORKER_DATABASE_URL=postgresql://user:password@direct-host/database?sslmode=require
# Optional disposable working directory. Checkpoints are restored from Postgres.
# STELA_IO_WORK_DIRECTORY=/tmp/stela-io-worker

# Local twscrape provider (manual selection in the prototype UI)
# Use the Python interpreter where twscrape 0.20.x is installed.
STELA_TWSCRAPE_PYTHON=python3
STELA_TWSCRAPE_DB=~/accounts.db
STELA_TWSCRAPE_MAX_REQUESTS=2000
